\@writefile{lof}{\contentsline {figure}{\numberline {13.2}{\ignorespaces Figura maestra de \texttt  {Mpemba-X v2}: el efecto Mpemba en nueve marcos teóricos. (a) Markovian Lu-Raz: cruzamiento de $D_{e}(t)$ a $t^{\ast }=22.4$; (b) Klich-Raz: cambio de signo de $a_2(T)$ en $T^{\ast } \approx 0.76$; (c) Lasanta analítico: cruzamiento de $T(t)$ a $t^{\ast }=0.18$; (d) Langevin colloid (Kumar-Bechhoefer): cruzamiento a $t^{\ast }=0.0325$; (e) Langevin inverso (Kumar-Chétrite): no se observa cruzamiento (configuración sin tuneo fino); (f) Lindblad cuántico + QFI: ganancia metrológica del 40\% en $T_{0}= 0.3$; (g) Agua Fourier (Zhang): cruzamiento en $t^{\ast } \approx 1610$ s; (h) MD agua (Jin-Goddard): coordinación local; (i) Termomayorización (Vu-Hayakawa): el gap mínimo cruza cero a $t \approx 8$, \textbf  {certificando el efecto Mpemba bajo TODAS las métricas monótonas simultáneamente}.}}{66}{figure.caption.13}\protected@file@percent }
\newlabel{fig:summary_v2}{{13.2}{66}{Figura maestra de \texttt {Mpemba-X v2}: el efecto Mpemba en nueve marcos teóricos. (a) Markovian Lu-Raz: cruzamiento de $\Dee (t)$ a $t^{\ast }=22.4$; (b) Klich-Raz: cambio de signo de $a_2(T)$ en $T^{\ast } \approx 0.76$; (c) Lasanta analítico: cruzamiento de $T(t)$ a $t^{\ast }=0.18$; (d) Langevin colloid (Kumar-Bechhoefer): cruzamiento a $t^{\ast }=0.0325$; (e) Langevin inverso (Kumar-Chétrite): no se observa cruzamiento (configuración sin tuneo fino); (f) Lindblad cuántico + QFI: ganancia metrológica del 40\% en $\Tinit = 0.3$; (g) Agua Fourier (Zhang): cruzamiento en $t^{\ast } \approx 1610$ s; (h) MD agua (Jin-Goddard): coordinación local; (i) Termomayorización (Vu-Hayakawa): el gap mínimo cruza cero a $t \approx 8$, \textbf {certificando el efecto Mpemba bajo TODAS las métricas monótonas simultáneamente}}{figure.caption.13}{}}
\newlabel{fig:summary_v2@cref}{{[figure][2][13]13.2}{[1][65][]66}{}{}{}}
